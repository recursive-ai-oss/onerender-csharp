<Project>

  <PropertyGroup Label="Name">
    <!-- The one place the project name lives. Assembly and namespace names start with $(LibName). -->
    <LibName>OneRender</LibName>
    <!-- NuGet package IDs are $(PackagePrefix)<assembly name>; this is the only place the prefix is written. -->
    <PackagePrefix>RecursiveAI.</PackagePrefix>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <!-- Build output stays out of the source folders. Set ONERENDER_ARTIFACTS to choose where; the default is artifacts/ at the
         repository root, which .gitignore covers and which file-sync tools skip. -->
    <ArtifactsPath Condition="'$(ONERENDER_ARTIFACTS)' != ''">$(ONERENDER_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ONERENDER_ARTIFACTS)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="Language and analysis">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Safe, bounds-checked C# throughout: no pointers, no reinterpret casts. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible packages">
    <_ProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <_SrcDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_SrcDir>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' and $(_ProjectDir.StartsWith('$(_SrcDir)'))">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright (c) Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <!-- The one place the package version lives. -->
    <Version>1.0.1</Version>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/recursive-ai-oss/onerender-csharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/recursive-ai-oss/onerender-csharp</PackageProjectUrl>
    <PackageTags>html;css;layout;rendering;pdf;onerender</PackageTags>
  </PropertyGroup>

</Project>
