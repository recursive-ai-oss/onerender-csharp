<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneRender.WasmSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- The check is that the libraries trim cleanly for WebAssembly. Relinking the native runtime adds nothing to that,
         and with the wasm-tools workload installed it would make every solution build run the native toolchain.
         Invariant globalization requires that relink on WebAssembly, so this app alone keeps the default; the libraries'
         culture independence is held by their own analyzers and tests, not by this setting. -->
    <WasmBuildNative>false</WasmBuildNative>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../testdata/fonts/NotoSansHebrew-Subset-Regular.woff2" LogicalName="hebrew.woff2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneRender/OneRender.csproj" />
    <ProjectReference Include="../../src/OneRender.Image/OneRender.Image.csproj" />
    <ProjectReference Include="../../src/OneRender.Pdf/OneRender.Pdf.csproj" />
    <ProjectReference Include="../../src/OneRender.Accessibility/OneRender.Accessibility.csproj" />
    <ProjectReference Include="../../src/OneRender.Fonts/OneRender.Fonts.csproj" />
  </ItemGroup>

</Project>
