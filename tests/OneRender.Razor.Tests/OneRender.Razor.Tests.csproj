<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneRender.Razor.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="RecursiveAI.OnePdf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneRender.Razor/OneRender.Razor.csproj" />
    <ProjectReference Include="../../samples/InvoiceApp/InvoiceApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/InvoiceApp/wwwroot/**" Link="sample-wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
