<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneRender.Pdf.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="RecursiveAI.OnePdf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneRender/OneRender.csproj" />
    <ProjectReference Include="../../src/OneRender.Image/OneRender.Image.csproj" />
    <ProjectReference Include="../../src/OneRender.Pdf/OneRender.Pdf.csproj" />
    <ProjectReference Include="../../src/OneRender.Fonts/OneRender.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../testdata/templates/**" Link="testdata/templates/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
