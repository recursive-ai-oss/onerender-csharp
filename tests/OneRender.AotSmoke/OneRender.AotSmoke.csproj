<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneRender.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../testdata/fonts/NotoSansHebrew-Subset-Regular.woff2" LogicalName="hebrew.woff2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneRender/OneRender.csproj" />
    <ProjectReference Include="../../src/OneRender.Image/OneRender.Image.csproj" />
    <ProjectReference Include="../../src/OneRender.Pdf/OneRender.Pdf.csproj" />
    <ProjectReference Include="../../src/OneRender.Accessibility/OneRender.Accessibility.csproj" />
    <ProjectReference Include="../../src/OneRender.Fonts/OneRender.Fonts.csproj" />
  </ItemGroup>

</Project>
