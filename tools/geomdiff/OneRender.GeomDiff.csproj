<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneRender.GeomDiff</RootNamespace>
    <AssemblyName>onerender-geomdiff</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneRender.GeomDiff.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneRender/OneRender.csproj" />
    <ProjectReference Include="../../src/OneRender.Image/OneRender.Image.csproj" />
  </ItemGroup>

</Project>
