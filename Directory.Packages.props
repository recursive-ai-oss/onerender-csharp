<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Family libraries, from NuGet">
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.0.0" />
    <PackageVersion Include="RecursiveAI.OneFont" Version="1.3.0" />
    <PackageVersion Include="RecursiveAI.OnePdf" Version="1.10.1" />
    <PackageVersion Include="RecursiveAI.OneImage" Version="1.10.1" />
  </ItemGroup>
  <ItemGroup Label="Tests and benchmarks only">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
